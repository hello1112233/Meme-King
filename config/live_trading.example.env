# Meme King Live Trading Configuration
# COPY this file to config/live_trading.env and fill in real values.
# NEVER commit the real .env file.

# ---------------------------------------------------------------------------
# Safety gates — all defaults block real trading
# ---------------------------------------------------------------------------
ENABLE_LIVE_TRADING=false
ENABLE_REAL_WALLET=false
ENABLE_TRANSACTION_SEND=false

# ---------------------------------------------------------------------------
# Risk limits (strict defaults for micro testing)
# ---------------------------------------------------------------------------
MAX_POSITION_SOL=0.01
MAX_DAILY_LOSS_SOL=0.05
MAX_OPEN_POSITIONS=1
DEFAULT_SLIPPAGE_BPS=1500
MAX_SLIPPAGE_BPS=3000
PRIORITY_FEE_MICROLAMPORTS=50000
JITO_TIP_LAMPORTS=0

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
HELIUS_API_KEY=
HELIUS_RPC_URL=
HELIUS_SENDER_URL=
JUPITER_API_BASE=
PUMPPORTAL_WS_URL=
PUMPSWAP_API_BASE=
PUMPFUN_API_BASE=

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=

# ---------------------------------------------------------------------------
# Wallet (path to JSON keypair file, NOT the raw key)
# ---------------------------------------------------------------------------
WALLET_KEYPAIR_PATH=
